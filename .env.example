# Xiaomi MiMo OpenAI-compatible API. Keep the actual key only in .env.
MIMO_API_KEY="your-xiaomi-mimo-api-key"
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"

# Required for password-protected administrator login.
# Choose a long, unique password and keep the real .env file private.
ADMIN_USERNAME="lab-admin"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
